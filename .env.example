# ==============================================================================
# MERIDIAN — Environment Configuration Template
# Copy this file to .env and fill in your keys. NEVER commit .env with real secrets.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
DEBUG=true

# Demo Mode (true | false)
# When true, enables the Quick Demo Login bypass ('meridian2026') for local evaluation.
# Strictly forbidden when APP_ENV=production. Defaults to false.
DEMO_MODE=false

# JWT Secret Key
# Required. Must be a cryptographically secure random string (minimum 32 characters).
# Known placeholders and development defaults are strictly rejected at application startup.
# Generate a new random secret using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-secure-random-secret-key-min-32-chars-e-g-python-secrets-token-hex-32

# Service URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Database
# Local SQLite default: sqlite+aiosqlite:///./meridian.db
DATABASE_URL=sqlite+aiosqlite:///./meridian.db

# Google Gemini AI
# Get your API key from https://aistudio.google.com/ (optional: mock fallback is used if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# PayPal Developer Sandbox (REST API v2)
# Get credentials from https://developer.paypal.com/dashboard/applications/sandbox
# (optional: mock sandbox adapter is used if omitted)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_TIMEOUT_SECONDS=20
PAYPAL_MAX_RETRIES=2
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here
